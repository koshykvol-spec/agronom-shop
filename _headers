/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://www.google-analytics.com https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.clarity.ms https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self' https://www.liqpay.ua; connect-src 'self' https://*.workers.dev https://*.deno.net https://cloudflareinsights.com https://www.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://c.bing.com https://challenges.cloudflare.com

# Продакшн-деплой іде напряму через Git-інтеграцію Cloudflare Pages (push у main),
# а НЕ через deploy.sh — тому ?v=<час деплою>, який мав додавати deploy.sh, ніколи
# не застосовується, і index.html/category.html підключають app.js БЕЗ версії.
# Cloudflare Pages кешує статику за розширенням файла на своїй CDN на кілька годин.
# Раніше вважалося, що _headers не може це перекрити — це невірно (офіційна
# документація Cloudflare Pages підтверджує підтримку Cache-Control у _headers).
# Тому для файлів, які редагуються найчастіше (JS/CSS логіки сайту), примусово
# вимикаємо тривале кешування: must-revalidate змушує браузер/CDN звірятись
# з origin (дешевий 304, якщо файл не змінився) замість сліпого показу старої копії.
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/cart.js
  Cache-Control: public, max-age=0, must-revalidate
/seo-jsonld.js
  Cache-Control: public, max-age=0, must-revalidate
/seasonal-helper.js
  Cache-Control: public, max-age=0, must-revalidate
/footer.js
  Cache-Control: public, max-age=0, must-revalidate
/style.css
  Cache-Control: public, max-age=0, must-revalidate
/recipes.css
  Cache-Control: public, max-age=0, must-revalidate
/md-render.js
  Cache-Control: public, max-age=0, must-revalidate
